# Arcadia notification service — local configuration.
#
#   cp .env.example .env
#
# Development defaults, not secrets. Every credential here says change-me on purpose.

ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=true
HTTP_PORT=8086

# One database and role per service, created by the infra repo's Postgres init script.
DATABASE_URL=postgresql://notification_user:notification_pass@localhost:5432/arcadia_notification

# Must match whatever the Auth service signs with. Minimum 32 characters.
JWT_SECRET=local-development-jwt-secret-change-me-please

# Verified, not optional — these match what the Go wallet and payment services require, so a
# token accepted here is accepted everywhere. Set either to empty to stop checking it, which
# should be a deliberate decision rather than an accident.
JWT_ISSUER=arcadia-auth
JWT_AUDIENCE=arcadia

KAFKA_ENABLED=true
KAFKA_BROKERS=localhost:29092

# The five topics this service reads. It produces nothing, so it owns none of them — the only
# thing it ever sends is a dead letter, to <topic>.dlq.
#
# trade-events and festival-events belong to services that do not exist yet. Subscribed anyway:
# an empty topic costs nothing, a consumer group on one is silent, and notifications start the
# day those services ship rather than the day somebody remembers to add them here.
TOPIC_GAME_EVENTS=game-events
TOPIC_PURCHASE_EVENTS=purchase-events
TOPIC_USER_EVENTS=user-events
TOPIC_TRADE_EVENTS=trade-events
TOPIC_FESTIVAL_EVENTS=festival-events

# One Kafka group per topic, suffixed from this. A group has a single subscription, so one
# group cannot span five topics — and separate groups also stop a slow topic holding up the rest.
CONSUMER_GROUP=notification-service
